# /opt/nili/.env
#
# The image repository and tag to run. Rollback within the same repository is
#   sed -i 's|^TAG=.*|TAG=PREVIOUS_SHA|' .env
#   docker compose --env-file .env -f docker-compose.prod.yml up -d
# exactly as documented for Alidade — the tag is a commit SHA, images stay in
# GHCR under that SHA, and a week of them stay on the box.

IMAGE=ghcr.io/aysanz/nili-design-system
TAG=latest
