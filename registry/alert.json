            "lighter",
            "stroke"
          ]
        },
        "size": {
          "type": "'x-small' | 'small' | 'large'",
          "required": false,
          "doc": null,
          "control": "select",
          "default": "small",
          "source": "cva",
          "options": [
            "x-small",
            "small",
            "large"
          ]
        }
      }
    }
  ]
}
