          "stroke"
        ],
        "size": [
          "x-small",
          "small",
          "large"
        ]
      },
      "defaultVariants": {
        "status": "info",
        "appearance": "filled",
        "size": "small"
      },
      "slots": [],
      "extends": [],
      "props": {
        "status": {
          "type": "'error' | 'warning' | 'success' | 'info' | 'feature'",
          "required": false,
          "doc": null,
          "control": "select",
          "default": "info",
          "source": "cva",
          "options": [
            "error",
            "warning",
            "success",
            "info",
            "feature"
          ]
        },
        "appearance": {
          "type": "'filled' | 'light' | 'lighter' | 'stroke'",
          "required": false,
