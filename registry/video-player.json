          "doc": null,
          "control": "handler"
        },
        "onTimeChange": {
          "type": "(currentTime: number) => void",
          "required": false,
          "doc": null,
          "control": "handler"
        },
        "locale": {
          "type": "string",
          "required": false,
          "doc": "BCP-47 tag driving the timestamps (`'fa'` → Persian). Defaults to the ambient locale from `NiliProvider`.",
          "control": "text"
        },
        "labels": {
          "type": "VideoPlayerLabels",
          "required": false,
          "doc": null,
          "control": "none"
