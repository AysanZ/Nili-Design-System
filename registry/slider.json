    ]
  },
  "components": [
    {
      "name": "Slider",
      "exported": true,
      "variants": {},
      "defaultVariants": {},
      "slots": [],
      "extends": [
        "Omit< ComponentPropsWithoutRef<'div'>, 'onChange' | 'defaultValue' | 'color' >"
      ],
      "props": {
        "children": {
          "type": "ReactNode",
          "control": "slot",
          "required": false,
          "doc": null,
          "source": "dom"
        },
        "aria-label": {
          "type": "string",
          "control": "text",
          "required": false,
          "doc": null,
          "source": "dom"
        },
        "value": {
          "type": "SliderValue",
          "required": false,
          "doc": "Controlled value. A `number` renders one thumb, a `[number, number]` renders a range — the shape of the value *is* Figma's \"Type\", so a range slider cannot be handed a single number by accident.",
          "control": "none"
        },
        "defaultValue": {
          "type": "SliderValue",
          "required": false,
          "doc": null,
          "control": "none",
          "default": 0
        },
        "onValueChange": {
          "type": "(value: SliderValue) => void",
          "required": false,
          "doc": "Fires on every step while dragging.",
          "control": "handler"
        },
        "onValueCommit": {
          "type": "(value: SliderValue) => void",
          "required": false,
          "doc": "Fires once, when the pointer or key is released. Use this for anything expensive — a request per pixel of drag is the usual way a slider takes a server down.",
          "control": "handler"
        },
        "min": {
          "type": "number",
          "required": false,
          "doc": null,
          "control": "number",
          "default": 0
        },
        "max": {
          "type": "number",
          "required": false,
          "doc": null,
          "control": "number",
          "default": 100
        },
        "step": {
          "type": "number",
          "required": false,
          "doc": null,
          "control": "number",
          "default": 1
        },
        "minStepsBetweenThumbs": {
          "type": "number",
          "required": false,
          "doc": "Smallest allowed gap between the two thumbs of a range.",
          "control": "number",
          "default": 0
        },
        "disabled": {
          "type": "boolean",
          "required": false,
          "doc": null,
          "control": "boolean",
          "default": false
        },
        "label": {
          "type": "ReactNode",
          "required": false,
          "doc": "Visible label above the track. Also names the thumbs. Figma's \"Label\".",
          "control": "slot"
        },
        "sublabel": {
          "type": "ReactNode",
          "required": false,
          "doc": "Muted second line under the label. Figma's \"Sublabel\".",
          "control": "slot"
        },
        "showValue": {
          "type": "boolean",
          "required": false,
          "doc": "Shows the current value beside the label. Figma's \"Edit Amount\".",
          "control": "boolean",
          "default": false
        },
        "tooltip": {
          "type": "boolean",
          "required": false,
          "doc": "Value bubble above the thumb while dragging. Figma's \"Tooltip\".",
          "control": "boolean",
          "default": false
        },
        "formatValue": {
          "type": "(value: number) => string",
          "required": false,
          "doc": "Formats every number the user sees or hears. Defaults to localized digits.",
          "control": "handler"
        },
        "locale": {
          "type": "string",
          "required": false,
          "doc": "BCP-47 tag driving the digits (`'fa'` → Persian). Defaults to the ambient locale from `NiliProvider`.",
          "control": "text"
        },
        "dir": {
          "type": "'ltr' | 'rtl'",
          "required": false,
          "doc": "Forces the drag direction, overriding the ambient locale. Needed for a track whose axis is not the reading axis — a video timeline runs from the video's start to its end, which is not a sentence, so it is pinned `ltr` even in a Persian UI. Without this the CSS renders one way and the pointer maths mirrors the other, and the playhead jumps backwards.",
          "control": "select",
          "options": [
            "ltr",
            "rtl"
          ]
        },
        "thumbLabels": {
          "type": "[string, string?]",
          "required": false,
          "doc": "Accessible names for the thumbs, when there is no visible `label`.",
          "control": "none"
        },
        "name": {
          "type": "string",
          "required": false,
          "doc": "`name` for the hidden inputs, when the form is submitted natively.",
          "control": "text"
        }
      }
    },
