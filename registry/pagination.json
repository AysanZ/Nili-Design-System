        "boundaryCount": {
          "type": "number",
          "required": false,
          "doc": "Pages pinned at each end of the trail.",
          "control": "number"
        },
        "type": {
          "type": "PaginationType",
          "required": false,
          "doc": null,
          "control": "select",
          "options": [
            "basic",
            "full-radius",
            "group"
          ]
        },
        "deviceMode": {
          "type": "PaginationDeviceMode",
          "required": false,
          "doc": "Figma's `Device Mode`. `mobile` shows arrows plus a summary, not cells.",
          "control": "select",
          "options": [
            "desktop",
            "mobile"
          ]
        },
        "align": {
          "type": "PaginationAlign",
          "required": false,
          "doc": null,
          "control": "select",
          "options": [
            "start",
            "center",
            "end",
            "between"
          ],
          "default": "center",
          "source": "cva"
        },
        "showEdges": {
          "type": "boolean",
          "required": false,
          "doc": "Adds first/last jumps outside the arrows.",
          "control": "boolean"
        },
        "disabled": {
          "type": "boolean",
          "required": false,
          "doc": "Greys out the whole control — a table reloading, for instance.",
          "control": "boolean"
        },
        "advanced": {
          "type": "boolean",
          "required": false,
          "doc": "Figma's `🧪 Advanced`. Adds the \"Page 2 of 16\" summary before the trail and the rows-per-page control after it.",
          "control": "boolean"
        },
        "pageSize": {
          "type": "number",
          "required": false,
          "doc": "Rows per page. Only rendered when `advanced`.",
          "control": "number"
        },
        "pageSizeOptions": {
          "type": "number[]",
          "required": false,
          "doc": "Choices offered by the per-page control.",
          "control": "list"
        },
        "onPageSizeChange": {
          "type": "(pageSize: number) => void",
          "required": false,
          "doc": null,
          "control": "handler"
        },
        "locale": {
          "type": "string",
          "required": false,
          "doc": "BCP-47 tag driving the digits (`'fa'` → Persian). Defaults to the ambient locale from `NiliProvider`.",
          "control": "text"
        },
        "labels": {
          "type": "PaginationLabels",
          "required": false,
          "doc": null,
          "control": "none"
        }
